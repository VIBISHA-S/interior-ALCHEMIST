{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "interior-alchemist",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by OpenNext's caching; must match "name".
			"binding": "WORKER_SELF_REFERENCE",
			"service": "interior-alchemist"
		}
	],
	"images": {
		// next/image resizing through Cloudflare Images; without it the originals are served as-is.
		"binding": "IMAGES"
	},
	"routes": [
		{ "pattern": "interioralchemist.thegoatscale.com", "custom_domain": true }
	],
	"observability": { "enabled": true }
}
